# Copy to .env.local (git-ignored) and fill in. Never commit a real key.
# AI edit suggestions (POST /documents/:id/suggest). Without a key the route answers 503 and nothing else changes.
OPENROUTER_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-5.5)
# CLAUSE_SUGGEST_MODEL=anthropic/claude-sonnet-4.6

# Neon Auth (use the Auth URL from the CLAUSE Vercel project)
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=

# Generate a random 32-byte key (hex or base64). Keep this stable between deploys;
# changing it makes existing provider tokens unreadable.
CLAUSE_INTEGRATION_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://your-clause-deployment.example

# Configure each provider's OAuth application with callback URL:
# https://your-clause-deployment.example/api/integrations/<provider>/callback
# Provider IDs: imanage, netdocuments, onedrive, dropbox, google_drive, sharepoint, box
CLAUSE_ONEDRIVE_CLIENT_ID=
CLAUSE_ONEDRIVE_CLIENT_SECRET=
CLAUSE_DROPBOX_CLIENT_ID=
CLAUSE_DROPBOX_CLIENT_SECRET=
CLAUSE_GOOGLE_DRIVE_CLIENT_ID=
CLAUSE_GOOGLE_DRIVE_CLIENT_SECRET=
CLAUSE_SHAREPOINT_CLIENT_ID=
CLAUSE_SHAREPOINT_CLIENT_SECRET=
CLAUSE_BOX_CLIENT_ID=
CLAUSE_BOX_CLIENT_SECRET=

# iManage and NetDocuments deployments may require tenant-specific OAuth/API endpoints.
CLAUSE_IMANAGE_CLIENT_ID=
CLAUSE_IMANAGE_CLIENT_SECRET=
CLAUSE_IMANAGE_AUTH_URL=
CLAUSE_IMANAGE_TOKEN_URL=
CLAUSE_IMANAGE_API_BASE=
CLAUSE_NETDOCUMENTS_CLIENT_ID=
CLAUSE_NETDOCUMENTS_CLIENT_SECRET=
CLAUSE_NETDOCUMENTS_AUTH_URL=
CLAUSE_NETDOCUMENTS_TOKEN_URL=
CLAUSE_NETDOCUMENTS_API_BASE=
