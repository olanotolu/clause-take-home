# Copy to .env.local (git-ignored) and fill in. Never commit a real key.
# AI edit suggestions (POST /documents/:id/suggest). Without a key the route answers 503 and nothing else changes.
OPENROUTER_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-5.5)
# CLAUSE_SUGGEST_MODEL=anthropic/claude-sonnet-4.6
