{
  "name": "clause",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @clause/api dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "bench": "node bench/run.ts",
    "seed": "node apps/api/src/seed.ts",
    "dev:web": "pnpm --filter @clause/web dev",
    "mutate": "node scripts/mutate.ts",
    "suggest:smoke": "node --env-file-if-exists=.env.local scripts/suggest-smoke.ts",
    "gen:seed": "node scripts/gen-seed-data.ts",
    "ci:smoke": "node --env-file-if-exists=.env.local scripts/ci-smoke.ts",
    "bench:ci": "node --env-file-if-exists=.env.local bench/ci/run.ts",
    "bench:ci:report": "node bench/ci/report.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
